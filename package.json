{
  "name": "genshin-story-reader",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "bun run content:build && vite --host 127.0.0.1 --port 3000",
    "content:build": "bun scripts/build-content.ts",
    "build": "bun run content:build && vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run build && bun run typecheck && bun test",
    "format": "prettier --write .",
    "build:pages": "bun scripts/build-pages.ts",
    "preview:pages": "bun scripts/preview-pages.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "gray-matter": "4.0.3",
    "markdown-it": "15.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
